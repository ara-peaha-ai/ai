# Copy to .env (gitignored). Every var here is optional — the shell environment
# works too.

# Monid API key (for the `monid` CLI skill under .claude/skills/monid/).
# The CLI reads keys from its own store, not this var — register it once with:
#   monid keys add -k "$MONID_API_KEY" -l main
# In a container, run that from the entrypoint. Get a key at
# https://app.monid.ai/access/api-keys
#MONID_API_KEY=monid_live_xxx

# Force a browser instead of auto-detecting. One of:
#   chrome | chromium | brave | browserless | /absolute/path/to/binary
# Auto-detect order otherwise: OS default browser (if Chromium-family),
# then chrome, then chromium, then brave.
#AICLI_BROWSER=chrome

# browserless.io — used automatically on a headless host (no DISPLAY), or
# always when AICLI_BROWSER=browserless. Get the token from your browserless
# dashboard.
#BROWSERLESS_API_KEY=

# Override the browserless base URL (default: wss://production-sfo.browserless.io).
# Regions: production-sfo / production-lon / production-ams, or a self-hosted host.
#BROWSERLESS_URL=wss://production-lon.browserless.io

# Full WebSocket endpoint, wins over API_KEY + URL. For a self-hosted
# browserless with no token, set only this.
#BROWSERLESS_WS_ENDPOINT=

# Where chatgpt-image reads/writes the login cookies for the remote browser.
# Default: bin/ai/chatgpt-cookies.json
#CHATGPT_COOKIES_FILE=/path/to/chatgpt-cookies.json

# NVIDIA API key for `ai d` (DeepSeek through NVIDIA's free API).
# Get it at https://build.nvidia.com (account menu > API Keys).
#NVIDIA_API_KEY=nvapi-xxx

# Model `ai d` asks NVIDIA for (default: deepseek-ai/deepseek-v4.1-flash).
#AI_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash

# Milliseconds `ai d` waits for an answer before giving up (default: 300000).
#AI_TIMEOUT_MS=300000

# Model `ai ats` uses, a bin/ai/router.js id (default: anthropic/claude-sonnet-5.5).
#AI_ATS_MODEL=anthropic/claude-sonnet-5.5

# Vercel AI Gateway key, for router ids without a direct prefix (e.g. anthropic/...).
# https://vercel.com/ai-gateway
#AI_GATEWAY_API_KEY=

# Shared secret callers of `ai-bridge` send as "Authorization: Bearer <token>"
# (wisdom: NUXT_AI_CLI_TOKEN). Generate with: openssl rand -base64 32
#AI_CLI_TOKEN=

# Where `ai-bridge` listens (defaults: 127.0.0.1 and 4011). Inside a container set
# AI_BRIDGE_HOST=0.0.0.0 explicitly, or the tunnel and the Docker network cannot reach it.
#AI_BRIDGE_HOST=127.0.0.1
#AI_BRIDGE_PORT=4011

# DeepSeek platform key, for router ids deepseek-direct/<model>.
# https://platform.deepseek.com
#DEEPSEEK_API_KEY=

# DeepL API key for `translate-text`. Free plan keys end in ":fx" (deepl-node then
# calls api-free.deepl.com by itself). https://www.deepl.com/your-account/keys
#DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
