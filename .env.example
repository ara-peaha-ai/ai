# Copy to .env (gitignored). Every var here is optional — the shell environment
# works too. Only chatgpt-image reads these directly.

# Monid API key (for the `monid` CLI skill under .claude/skills/monid/).
# The CLI reads keys from its own store, not this var — register it once with:
#   monid keys add -k "$MONID_API_KEY" -l main
# In a container, run that from the entrypoint. Get a key at
# https://app.monid.ai/access/api-keys
#MONID_API_KEY=monid_live_xxx

# Force a browser instead of auto-detecting. One of:
#   chrome | chromium | brave | browserless | /absolute/path/to/binary
# Auto-detect order otherwise: OS default browser (if Chromium-family),
# then chrome, then chromium, then brave.
#AICLI_BROWSER=chrome

# browserless.io — used automatically on a headless host (no DISPLAY), or
# always when AICLI_BROWSER=browserless. Get the token from your browserless
# dashboard.
#BROWSERLESS_API_KEY=

# Override the browserless base URL (default: wss://production-sfo.browserless.io).
# Regions: production-sfo / production-lon / production-ams, or a self-hosted host.
#BROWSERLESS_URL=wss://production-lon.browserless.io

# Full WebSocket endpoint, wins over API_KEY + URL. For a self-hosted
# browserless with no token, set only this.
#BROWSERLESS_WS_ENDPOINT=

# Where chatgpt-image reads/writes the login cookies for the remote browser.
# Default: bin/chatgpt-cookies.json
#CHATGPT_COOKIES_FILE=/path/to/chatgpt-cookies.json
